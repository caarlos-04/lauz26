# Copy to .env (git-ignored) and fill in: cp .env.example .env
# Read by the desktop app at startup (shared/src/jvmMain/.../ai/AiConfig.jvm.kt). Never commit real keys.
# One key is enough; OpenAI is used first if both are set. Without keys the chat uses sample answers.
OPENAI_API_KEY=
# Optional: model id of the chosen provider (default gpt-4.1-mini)
TWIN_LLM_MODEL=
